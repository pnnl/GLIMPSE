# ============================================================================
# GLIMPSE backend — Flask + SocketIO (gevent) server
# ============================================================================

# ---- builder: install Python deps into /usr/local --------------------------
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY local-server/requirements.txt ./requirements.txt
RUN uv pip install --system -r requirements.txt

# ---- runtime: slim image with only the installed packages + app ------------
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    FLASK_HOST=0.0.0.0 \
    FLASK_PORT=5052

# Copy everything uv installed (site-packages + console scripts); uv stays behind.
COPY --from=builder /usr/local /usr/local

WORKDIR /app
COPY local-server/ ./

EXPOSE 5052
CMD ["python", "server.py"]
